
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>24시간 카운트다운</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #101318;
      color: #ffffff;
      font-family: Arial, sans-serif;
    }

    .timer {
      width: 100%;
      padding: 32px 12px;
      text-align: center;
    }

    .label {
      margin-bottom: 20px;
      color: #aab5c5;
      font-size: 14px;
      letter-spacing: 3px;
    }

    #clock {
      font-size: clamp(42px, 12vw, 100px);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      line-height: 1.2;
    }

    #date {
      margin-top: 20px;
      color: #c6cfdb;
      font-size: 16px;
    }
  </style>
</head>
<body>
  <main class="timer">
    <div class="label">24 HOUR COUNTDOWN</div>
    <div id="clock">24:00:00</div>
    <div id="date">한국 시간 확인 중...</div>
  </main>

  <script>
    (() => {
      // 2026년 11월 1일 00:00:00 한국 표준시
      const START = Date.parse("2026-11-01T00:00:00+09:00");
      const END = START + 24 * 60 * 60 * 1000;

      const clock = document.getElementById("clock");
      const date = document.getElementById("date");

      function formatTime(seconds) {
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = seconds % 60;

        return [h, m, s]
          .map(n => String(n).padStart(2, "0"))
          .join(":");
      }

      function update() {
        // 현재 시각을 UTC 기준으로 얻고, 표시할 때 한국 시간대를 지정
        const now = Date.now();

        let remaining;

        if (now < START) {
          remaining = 24 * 60 * 60;
        } else {
          remaining = Math.max(
            0,
            Math.ceil((END - now) / 1000)
          );
        }

        clock.textContent = formatTime(remaining);
        document.title = formatTime(remaining) + " | 카운트다운";

        date.textContent = new Intl.DateTimeFormat("ko-KR", {
          timeZone: "Asia/Seoul",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false
        }).format(new Date(now)) + " (한국 시간)";
      }

      update();
      setInterval(update, 100);
    })();
  </script>
</body>
</html>
